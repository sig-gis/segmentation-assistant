# Copy to .env and fill in. docker-compose reads this file automatically;
# the services read the same variables when run outside compose.

# --- Postgres / PostGIS (services/storage) ---
POSTGRES_USER=segsvc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=segmentation
# Connection string the API and finetune services use. Inside docker-compose
# the host is the service name `storage`; outside compose use localhost.
# Swapping this to a hosted Postgres is the entire "hosted storage" story.
DATABASE_URL=postgresql://segsvc:change-me@storage:5432/segmentation

# --- Model access ---
# Required at runtime (NOT for tests): gated facebook/sam3 weights.
# Get one at https://huggingface.co/settings/tokens after accepting the
# license at https://huggingface.co/facebook/sam3
HF_TOKEN=

# --- Checkpoint publishing (services/finetune) ---
# HF Hub model repo that trained LoRA adapters are pushed to, e.g. "your-org/sam3-rs-lora"
HF_ADAPTER_REPO=

# --- Paths ---
# Root directory for registered images, exported datasets, and job artifacts.
# Mounted into the api and finetune containers at /data.
DATA_DIR=./data

# --- SLURM training backend (leave empty to train locally) ---
# ssh host alias from ~/.ssh/config. The cluster is reachable only over VPN.
SLURM_SSH_HOST=
# Checkout of this repo on the cluster's shared filesystem
SLURM_REMOTE_ROOT=
# Python of the remote env that has sam3[train] + finetune installed
SLURM_REMOTE_PYTHON=
SLURM_PARTITION=
SLURM_ACCOUNT=
SLURM_QOS=
